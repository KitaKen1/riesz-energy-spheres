  have hp3 : 0 < s/2-1+3 := by linarith
  obtain ⟨C₂, hC₂, hC⟩ := sphere8_neg_sharp_allN (sphere8_lower4_of_sharp_profile hG8p) hB hstrat
    hsphere hp
  have hP : ∀ j : ℕ, ∀ᶠ N : ℕ in atTop, ∃ Y : Configuration N,
