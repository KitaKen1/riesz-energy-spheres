theorem sphere8_riesz_neg_lower_allN_of_profile (hG8p : SphereGaussianSharpProfileLower8) {B : ℝ} (hB : 0 ≤ B)
    (hstrat : ∀ {K : ℕ} (P : Fin K → SmallE8CubePatch8),
      NegStratifiable8 (⋃ i, smallE8CubeSet8 (P i))ᶜ B)
