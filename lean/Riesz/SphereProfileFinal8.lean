theorem sphere8_lower4_of_sharp_profile (hG8p : SphereGaussianSharpProfileLower8) :
    ∀ ε : ℝ, 0 < ε → ∃ N₀ : ℕ, ∀ N : ℕ, N₀ ≤ N → ∀ X : Configuration N,
      predictedCoefficient-ε ≤ normalizedEnergy X := by
  intro ε hε
  obtain ⟨N₀, hN₀⟩ := sphere8_riesz_sharp_lower_of_sharp_profile hG8p (s := 4) (by norm_num)
    (by norm_num) ε hε
