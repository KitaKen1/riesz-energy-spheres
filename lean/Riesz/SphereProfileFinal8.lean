      linarith)
  intro η hη
  obtain ⟨k₀, hk₀⟩ := eventually_atTop.mp (hmain η hη)
  refine ⟨k₀+N₁+1, fun N hN => ?_⟩
  obtain ⟨k, rfl⟩ : ∃ k, N = k+N₁+1 := ⟨N-N₁-1, by omega⟩
