set_option autoImplicit false
noncomputable section
open Set Filter MeasureTheory
open scoped Topology ENNReal
namespace SphericalRiesz
open Boundary
set_option maxHeartbeats 1000000 in
set_option maxHeartbeats 1000000 in


theorem sphere8_riesz_neg_lower_allN_unconditional  {B : ℝ} (hB : 0 ≤ B)
    (hstrat : ∀ {K : ℕ} (P : Fin K → SmallE8CubePatch8),
      NegStratifiable8 (⋃ i, smallE8CubeSet8 (P i))ᶜ B)
    (hsphere : SphereStratifiable8 B) {s : ℝ} (hs : -2 < s) (hs0 : s < 0) :
    ∀ η : ℝ, 0 < η → ∃ N₀ : ℕ, ∀ N : ℕ, N₀ ≤ N → ∃ Y : Configuration N,
      sphereRieszCoefficientNeg8 s-η ≤ normalizedEnergyNeg8 s Y  :=
  sphere8_riesz_neg_lower_allN_of_profile sphere8_gaussian_sharp_profile_lower hB hstrat hsphere hs hs0

theorem sphere8_riesz_neg_sharp_asymptotic_unconditional  {B : ℝ} (hB : 0 ≤ B)
    (hstrat : ∀ {K : ℕ} (P : Fin K → SmallE8CubePatch8),
      NegStratifiable8 (⋃ i, smallE8CubeSet8 (P i))ᶜ B)
    (hsphere : SphereStratifiable8 B) {s : ℝ} (hs : -2 < s) (hs0 : s < 0) :
    (∀ η : ℝ, 0 < η → ∃ N₀ : ℕ, ∀ N : ℕ, N₀ ≤ N → ∀ X : Configuration N,
      (energyRpow s X-(∫ p : Sphere8 × Sphere8, (dist p.1 p.2)^(-s)
          ∂(sphereProbability8.prod sphereProbability8))*(N:ℝ)^2)/(N:ℝ)^(1+s/8) ≤
        (sphereArea8.real univ)^(-(s/8))*(e8EpsteinCandidate ((s/2:ℝ):ℂ)).re+η) ∧
    (∀ η : ℝ, 0 < η → ∃ N₀ : ℕ, ∀ N : ℕ, N₀ ≤ N → ∃ Y : Configuration N,
      (sphereArea8.real univ)^(-(s/8))*(e8EpsteinCandidate ((s/2:ℝ):ℂ)).re-η ≤
        (energyRpow s Y-(∫ p : Sphere8 × Sphere8, (dist p.1 p.2)^(-s)
          ∂(sphereProbability8.prod sphereProbability8))*(N:ℝ)^2)/(N:ℝ)^(1+s/8))  :=
  sphere8_riesz_neg_sharp_asymptotic_of_profile sphere8_gaussian_sharp_profile_lower hB hstrat hsphere hs hs0

end SphericalRiesz
end
end

-- from Riesz/SphereCapDiscrepancyUpper8.lean
section
set_option autoImplicit false
noncomputable section
open Set Filter MeasureTheory
namespace SphericalRiesz
open Boundary


theorem sphere8_cap_discrepancy_upper_conjecture_form_unconditional  {B : ℝ}
    (hB : 0 ≤ B) (hstrat : ∀ {K : ℕ} (P : Fin K → SmallE8CubePatch8),
      NegStratifiable8 (⋃ i, smallE8CubeSet8 (P i))ᶜ B)
    (hsphere : SphereStratifiable8 B) :
    ∀ η : ℝ, 0 < η → ∃ N₀ : ℕ, ∀ N : ℕ, N₀ ≤ N → ∃ X : Configuration N,
      (N:ℝ)^(1+(1:ℝ)/8)*capDiscrepancyL2Sq8 X ≤
        sphereAbsMoment8/2*(-((sphereArea8.real univ)^((1:ℝ)/8)*
          (e8EpsteinCandidate ((-1/2:ℝ):ℂ)).re))+η  :=
  sphere8_cap_discrepancy_upper_conjecture_form_of_profile sphere8_gaussian_sharp_profile_lower hB hstrat hsphere

theorem sphere8_cap_discrepancy_sqrt_upper_unconditional  {B : ℝ} (hB : 0 ≤ B)
    (hstrat : ∀ {K : ℕ} (P : Fin K → SmallE8CubePatch8),
      NegStratifiable8 (⋃ i, smallE8CubeSet8 (P i))ᶜ B)
    (hsphere : SphereStratifiable8 B) :
    ∀ η : ℝ, 0 < η → ∃ N₀ : ℕ, ∀ N : ℕ, N₀ ≤ N → ∃ X : Configuration N,
      (N:ℝ)^((1:ℝ)/2+1/16)*Real.sqrt (capDiscrepancyL2Sq8 X) ≤ sphereCapDiscrepancyConst8+η  :=
  sphere8_cap_discrepancy_sqrt_upper_of_profile sphere8_gaussian_sharp_profile_lower hB hstrat hsphere

theorem sphere8_cap_discrepancy_sharp_unconditional  {B : ℝ} (hB : 0 ≤ B)
    (hstrat : ∀ {K : ℕ} (P : Fin K → SmallE8CubePatch8),
      NegStratifiable8 (⋃ i, smallE8CubeSet8 (P i))ᶜ B)
    (hsphere : SphereStratifiable8 B) :
    ∀ η : ℝ, 0 < η → ∃ N₀ : ℕ, ∀ N : ℕ, N₀ ≤ N →
      (∀ X : Configuration N, sphereCapDiscrepancyConst8-η ≤
        (N:ℝ)^((1:ℝ)/2+1/16)*Real.sqrt (capDiscrepancyL2Sq8 X)) ∧
      ∃ X : Configuration N,
        (N:ℝ)^((1:ℝ)/2+1/16)*Real.sqrt (capDiscrepancyL2Sq8 X) ≤ sphereCapDiscrepancyConst8+η  :=
  sphere8_cap_discrepancy_sharp_of_profile sphere8_gaussian_sharp_profile_lower hB hstrat hsphere

end SphericalRiesz
end
end

-- from Riesz/SphereLogUpper8.lean
section
set_option autoImplicit false
noncomputable section
open Set Filter MeasureTheory
open scoped Topology
namespace SphericalRiesz
open Boundary


theorem sphere8_log_upper_allN_unconditional  {B : ℝ} (hB : 0 ≤ B)
    (hstrat : ∀ {K : ℕ} (P : Fin K → SmallE8CubePatch8),
      NegStratifiable8 (⋃ i, smallE8CubeSet8 (P i))ᶜ B)
    (hsphere : SphereStratifiable8 B) :
    ∀ η : ℝ, 0 < η → ∃ N₀ : ℕ, ∀ N : ℕ, N₀ ≤ N → ∃ Y : Configuration N,
      normalizedEnergyLog8 Y ≤ sphereLogCoefficient8+η  :=
  sphere8_log_upper_allN_of_profile sphere8_gaussian_sharp_profile_lower hB hstrat hsphere

theorem sphere8_log_sharp_asymptotic_unconditional  {B : ℝ} (hB : 0 ≤ B)
    (hstrat : ∀ {K : ℕ} (P : Fin K → SmallE8CubePatch8),
      NegStratifiable8 (⋃ i, smallE8CubeSet8 (P i))ᶜ B)
    (hsphere : SphereStratifiable8 B) :
    (∀ η : ℝ, 0 < η → ∃ N₀ : ℕ, ∀ N : ℕ, N₀ ≤ N → ∀ X : Configuration N,
      -60*(deriv riemannZeta (-3)).re+(5/8)*Real.log 2-(1/8)*Real.log 105-η ≤
        (energyLog X-(∫ p : Sphere8 × Sphere8, -Real.log (dist p.1 p.2)
          ∂(sphereProbability8.prod sphereProbability8))*(N:ℝ)^2+(N:ℝ)/8*Real.log N)/(N:ℝ)) ∧
    (∀ η : ℝ, 0 < η → ∃ N₀ : ℕ, ∀ N : ℕ, N₀ ≤ N → ∃ Y : Configuration N,
      (energyLog Y-(∫ p : Sphere8 × Sphere8, -Real.log (dist p.1 p.2)
          ∂(sphereProbability8.prod sphereProbability8))*(N:ℝ)^2+(N:ℝ)/8*Real.log N)/(N:ℝ) ≤
        -60*(deriv riemannZeta (-3)).re+(5/8)*Real.log 2-(1/8)*Real.log 105+η)  :=
  sphere8_log_sharp_asymptotic_of_profile sphere8_gaussian_sharp_profile_lower hB hstrat hsphere

end SphericalRiesz
end
end

