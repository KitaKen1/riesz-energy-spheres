-- from Riesz/OptimalSphereEnergy.lean
section
set_option autoImplicit false
noncomputable section
open Set MeasureTheory Filter
open scoped Topology
namespace SphericalRiesz


theorem sphere8_minimum_riesz_tendsto_unconditional  {s : ℝ}
    (hs : 0 < s) (hs8 : s < 8) :
    Tendsto (normalizedMinimumRieszEnergyD 8 s) atTop (𝓝 (sphereRieszCoefficient8 s))  :=
  sphere8_minimum_riesz_tendsto_of_profile sphere8_gaussian_sharp_profile_lower hs hs8

theorem sphere8_minimum_riesz_tendsto_epstein_unconditional  {s : ℝ}
    (hs : 0 < s) (hs8 : s < 8) (hs2 : s ≠ 2) :
    Tendsto (normalizedMinimumRieszEnergyD 8 s) atTop
      (𝓝 ((sphereArea8.real univ)^(-(s/8))*(e8EpsteinCandidate ((s/2:ℝ):ℂ)).re))  :=
  sphere8_minimum_riesz_tendsto_epstein_of_profile sphere8_gaussian_sharp_profile_lower hs hs8 hs2

theorem sphere8_minimum_riesz_two_tendsto_unconditional :
    Tendsto (normalizedMinimumRieszEnergyD 8 2) atTop
      (𝓝 ((sphereArea8.real univ)^(-((2:ℝ)/8))*(120*(deriv riemannZeta (-2)).re)))  :=
  sphere8_minimum_riesz_two_tendsto_of_profile sphere8_gaussian_sharp_profile_lower

theorem sphere8_maximum_riesz_tendsto_unconditional  {s : ℝ}
    (hs : -2 < s) (hs0 : s < 0) :
    Tendsto (normalizedMaximumRieszEnergyD 8 s) atTop
      (𝓝 ((sphereArea8.real univ)^(-(s/8))*(e8EpsteinCandidate ((s/2:ℝ):ℂ)).re))  :=
  sphere8_maximum_riesz_tendsto_of_profile sphere8_gaussian_sharp_profile_lower hs hs0

theorem sphere8_minimum_log_tendsto_unconditional :
    Tendsto (normalizedMinimumLogEnergyD 8) atTop
      (𝓝 (-60*(deriv riemannZeta (-3)).re+(5/8)*Real.log 2-(1/8)*Real.log 105))  :=
  sphere8_minimum_log_tendsto_of_profile sphere8_gaussian_sharp_profile_lower

theorem sphere8_minimum_cap_discrepancy_tendsto_unconditional :
    Tendsto (fun N : ℕ => (N:ℝ)^((1:ℝ)/2+1/16)*minimumCapDiscrepancy8 N)
      atTop (𝓝 sphereCapDiscrepancyConst8)  :=
  sphere8_minimum_cap_discrepancy_tendsto_of_profile sphere8_gaussian_sharp_profile_lower

end SphericalRiesz
end
end
