      ∀ X : Configuration N, sphereRieszCoefficient8 s-η ≤ normalizedEnergyRpow s X  :=
  sphere8_riesz_sharp_lower_of_sharp_profile sphere8_gaussian_sharp_profile_lower hs hs8

end SphericalRiesz
end
end

