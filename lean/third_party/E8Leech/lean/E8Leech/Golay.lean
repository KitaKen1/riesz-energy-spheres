-- Separate certificates keep each kernel computation within the default resource limits.
private theorem golayWeightTable_correct_0 :
    ∀ j : Fin 256, hammingNorm (golayEncode (golayMessageEquiv (0, j))) = golayWeightTable 0 j := by
  decide +kernel

