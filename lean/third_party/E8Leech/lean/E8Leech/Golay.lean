private theorem golayWeightTable_correct (i : Fin 16) :
    ∀ j : Fin 256, hammingNorm (golayEncode (golayMessageEquiv (i, j))) = golayWeightTable i j := by
  fin_cases i
  · exact golayWeightTable_correct_0
  · exact golayWeightTable_correct_1
