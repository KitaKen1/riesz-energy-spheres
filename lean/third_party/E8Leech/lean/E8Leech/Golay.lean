  · exact golayWeightTable_correct_14
  · exact golayWeightTable_correct_15

/-- The only weights of the extended binary Golay code are `0`, `8`, `12`, `16`, and `24`. -/
theorem golay_hammingNorm_mem {x : Fin 24 → ZMod 2} (hx : x ∈ golayCode) :
    hammingNorm x ∈ ({0, 8, 12, 16, 24} : Finset ℕ) := by
  obtain ⟨a, rfl⟩ := golay_mem_iff.mp hx
  obtain ⟨⟨i, j⟩, rfl⟩ := golayMessageEquiv.surjective a
  rw [golayWeightTable_correct]
  exact (by decide +kernel : ∀ i j, golayWeightTable i j ∈ ({0, 8, 12, 16, 24} : Finset ℕ)) i j


