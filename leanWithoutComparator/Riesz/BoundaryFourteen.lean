      ((fourteenUnitPeanoKernel_continuous m).continuousOn.mul hg).abs
  have hj : IntervalIntegrable (fun t => ((10^24)/(m : ℝ)^14)*|g t|) volume 0 1 := by
    apply ContinuousOn.intervalIntegrable
    simpa only [Set.uIcc_of_le (by norm_num : (0 : ℝ) ≤ 1), Pi.mul_def] using
      (continuousOn_const (c := ((10^24)/(m : ℝ)^14))).mul hg.abs
  calc
    _ ≤ ∫ t in (0 : ℝ)..1, |fourteenUnitPeanoKernel m t*g t| :=
