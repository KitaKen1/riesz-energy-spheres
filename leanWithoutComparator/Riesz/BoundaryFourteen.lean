open Polynomial

def fourteenPolynomial : Polynomial ℝ :=
    .X^12 +
    .C ((-5967932062050553703316848640000 : ℝ)/39797268543821419527536640000) * .X^11 +
    .C ((394400915132646278273307770880000 : ℝ)/39797268543821419527536640000) * .X^10 +
    .C ((-15105230179713686587092076855296000 : ℝ)/39797268543821419527536640000) * .X^9 +
    .C ((370859241326839829669913827475456000 : ℝ)/39797268543821419527536640000) * .X^8 +
    .C ((-6096472475818010458475574929129472000 : ℝ)/39797268543821419527536640000) * .X^7 +
    .C ((68048854619303882754173669104366387200 : ℝ)/39797268543821419527536640000) * .X^6 +
    .C ((-512125987223843818982931947592823603200 : ℝ)/39797268543821419527536640000) * .X^5 +
    .C ((2528224341075879905139876761184409190400 : ℝ)/39797268543821419527536640000) * .X^4 +
    .C ((-7760171102434405612950466998058479759360 : ℝ)/39797268543821419527536640000) * .X^3 +
    .C ((13455313218097935797501540146436673288960 : ℝ)/39797268543821419527536640000) * .X^2 +
    .C ((-10969262263760929236495546270112222377120 : ℝ)/39797268543821419527536640000) * .X^1 +
    .C ((2709204514402478681689254207272447614051 : ℝ)/39797268543821419527536640000) * .X^0

theorem fourteenPolynomial_eval (x : ℝ) :
    fourteenPolynomial.eval x = fourteenCandidateP x / 39797268543821419527536640000 := by
  simp [fourteenPolynomial, fourteenCandidateP]
  ring

theorem fourteenPolynomial_node (i : Fin 12) : fourteenPolynomial.eval (fourteenCandidateNode i) = 0 := by
  rw [fourteenPolynomial_eval, (fourteenCandidateNode_spec i).2.2]
  norm_num

theorem fourteenPolynomial_natDegree : fourteenPolynomial.natDegree = 12 := by
  unfold fourteenPolynomial
  compute_degree <;> norm_num

theorem fourteenPolynomial_monic : fourteenPolynomial.Monic := by
  rw [Polynomial.Monic, Polynomial.leadingCoeff, fourteenPolynomial_natDegree]
  norm_num [fourteenPolynomial, Polynomial.coeff_add, Polynomial.coeff_C_mul_X_pow]

def fourteenRoots : Multiset ℝ := Finset.univ.val.map fourteenCandidateNode

theorem fourteenPolynomial_roots : fourteenPolynomial.roots = fourteenRoots := by
  classical
  let e : Fin 12 ↪ ℝ := ⟨fourteenCandidateNode, fourteenCandidateNode_injective⟩
  have h := Polynomial.roots_eq_of_natDegree_le_card_of_ne_zero
    (p := fourteenPolynomial) (S := Finset.univ.map e) (by
      intro x hx
      obtain ⟨i, _, rfl⟩ := Finset.mem_map.mp hx
      exact fourteenPolynomial_node i) (by simp [fourteenPolynomial_natDegree])
    fourteenPolynomial_monic.ne_zero
  exact h

theorem fourteenPolynomial_factor :
    fourteenPolynomial = ∏ i : Fin 12, (.X - .C (fourteenCandidateNode i)) := by
  have h := Polynomial.prod_multiset_X_sub_C_of_monic_of_roots_card_eq
    fourteenPolynomial_monic (by rw [fourteenPolynomial_roots]; simp [fourteenRoots,fourteenPolynomial_natDegree])
  rw [fourteenPolynomial_roots] at h
  simpa [fourteenRoots, Multiset.map_map, Finset.prod] using h.symm

def fourteenElementary (k : ℕ) : ℝ := (-1)^k * fourteenPolynomial.coeff (12-k)

theorem fourteenElementary_eq (k : ℕ) (hk : k ≤ 12) :
    MvPolynomial.aeval fourteenCandidateNode (MvPolynomial.esymm (Fin 12) ℝ k) =
      fourteenElementary k := by
  rw [MvPolynomial.aeval_esymm_eq_multiset_esymm]
  change fourteenRoots.esymm k = fourteenElementary k
  have h := Polynomial.coeff_eq_esymm_roots_of_card
    (p := fourteenPolynomial) (by rw [fourteenPolynomial_roots]; simp [fourteenRoots,fourteenPolynomial_natDegree])
    (k := 12-k) (by rw [fourteenPolynomial_natDegree]; omega)
  rw [fourteenPolynomial_monic.leadingCoeff,fourteenPolynomial_natDegree,fourteenPolynomial_roots] at h
  have hsub : 12-(12-k)=k := by omega
  rw [hsub,one_mul] at h
  unfold fourteenElementary
  rw [h]
  simp [← mul_assoc, ← pow_add, Even.neg_one_pow (show Even (k+k) from ⟨k,rfl⟩)]

def fourteenPowerSum (k : ℕ) : ℝ := ∑ i : Fin 12, fourteenCandidateNode i ^ k

theorem fourteenPowerSum_newton (k : ℕ) (hk : 0 < k) (hk10 : k ≤ 12) :
    fourteenPowerSum k = (-1)^(k+1) * k * fourteenElementary k -
      ∑ a ∈ Finset.antidiagonal k with a.1 ∈ Set.Ioo 0 k,
        (-1)^a.1 * fourteenElementary a.1 * fourteenPowerSum a.2 := by
  have h := congrArg (MvPolynomial.aeval fourteenCandidateNode)
    (MvPolynomial.psum_eq_mul_esymm_sub_sum (Fin 12) ℝ k hk)
  simp only [map_sub,map_mul,map_pow,map_neg,map_one,map_natCast,map_sum] at h
  simp only [MvPolynomial.psum, map_sum, map_pow,MvPolynomial.aeval_X] at h
  rw [fourteenElementary_eq k hk10] at h
  change fourteenPowerSum k = _ at h
  rw [h]
  congr 1
  apply Finset.sum_congr rfl
  intro a ha
  rw [fourteenElementary_eq a.1 (by
    have hmem := Finset.mem_filter.mp ha
    have hsum := Finset.mem_antidiagonal.mp hmem.1
    omega)]
  rfl

theorem fourteenPowerSum_1 : fourteenPowerSum 1 = (3599/24 : ℝ) := by
