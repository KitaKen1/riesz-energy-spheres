theorem fourteenUnitPeanoKernel_weighted_l1_bound {m : ℕ} (hm : 48 ≤ m) (g : ℝ → ℝ)
    (hg : ContinuousOn g (Set.Icc (0 : ℝ) 1)) :
    |∫ t in (0 : ℝ)..1, fourteenUnitPeanoKernel m t*g t| ≤
