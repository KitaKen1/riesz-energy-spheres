noncomputable section
namespace SphericalRiesz.Boundary

def fourteenStripNode : Fin 24 → ℝ := ![fourteenCandidateNode 0, fourteenCandidateNode 1, (5/2), fourteenCandidateNode 2, (9/2), fourteenCandidateNode 3, (13/2), (15/2), fourteenCandidateNode 4, (19/2), (21/2), fourteenCandidateNode 5, (25/2), (27/2), fourteenCandidateNode 6, (31/2), (33/2), fourteenCandidateNode 7, (37/2), fourteenCandidateNode 8, (41/2), fourteenCandidateNode 9, fourteenCandidateNode 10, fourteenCandidateNode 11]

def fourteenStripPowerSum (k : ℕ) : ℝ := ∑ i : Fin 24, fourteenStripNode i ^ k

theorem fourteenStripPowerSum_eq (k : ℕ) :
    fourteenStripPowerSum k = ∑ i : Fin 24, fourteenStripNode i ^ k := rfl

theorem fourteenStripPowerSum_0 : fourteenStripPowerSum 0 = (24:ℝ) := by
  norm_num [fourteenStripPowerSum, Fin.sum_univ_succ]

theorem fourteenStripPowerSum_1 : fourteenStripPowerSum 1 = ((6911/24):ℝ) := by
