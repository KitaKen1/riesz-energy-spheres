theorem fourteenMidpointPrimitive_step (k : Fin 14) (x : ℝ) :
    fourteenMidpointPrimitive k (x+1)-fourteenMidpointPrimitive k x = (x+1/2)^k.val := by
  fin_cases k <;> norm_num [fourteenMidpointPrimitive] <;> ring

theorem fourteen_shifted_midpoint_sum (k : Fin 14) (a : ℝ) (n : ℕ) :
    (∑ j ∈ Finset.range n, ((j:ℝ)+a+1/2)^k.val) =
      fourteenMidpointPrimitive k ((n:ℝ)+a)-fourteenMidpointPrimitive k a := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [Finset.sum_range_succ,ih]
    push_cast
    have h := fourteenMidpointPrimitive_step k ((n:ℝ)+a)
    rw [show (n:ℝ)+1+a = ((n:ℝ)+a)+1 by ring]
    linarith

