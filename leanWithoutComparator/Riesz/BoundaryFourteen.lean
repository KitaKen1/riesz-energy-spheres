theorem fourteenQuadrature_fourteenth_order_l1_bound_on {m : ℕ} (hm : 48 ≤ m) {f : ℝ → ℝ}
    (hf : ContDiffOn ℝ 14 f (Set.Icc (0 : ℝ) 1)) :
    |fourteenQuadrature m f-(∫ x in (0 : ℝ)..1, f x)| ≤ ((10^24)/(m : ℝ)^14)*
      (∫ t in (0 : ℝ)..1, |iteratedDerivWithin 14 f (Set.Icc (0 : ℝ) 1) t|) := by
  rw [fourteenQuadrature_fourteenth_order_error_on hm hf]
  exact fourteenUnitPeanoKernel_weighted_l1_bound hm _
    (hf.continuousOn_iteratedDerivWithin (by norm_num) (uniqueDiffOn_Icc (by norm_num)))

theorem fourteenQuadrature_cell_fourteenth_order_l1_bound_on {m : ℕ} (hm : 48 ≤ m) {f : ℝ → ℝ}
    (a w : ℝ) (hw : 0 < w) (hf : ContDiffOn ℝ 14 f (Set.Icc a (a+w))) :
    |w*fourteenQuadrature m (fun t => f (a+w*t))-(∫ x in a..a+w, f x)| ≤
      ((10^24)/(m : ℝ)^14)*w^14*(∫ x in a..a+w, |iteratedDerivWithin 14 f (Set.Icc a (a+w)) x|) := by
  have hg : ContDiffOn ℝ 14 (fun t => f (a+w*t)) (Set.Icc (0 : ℝ) 1) :=
    hf.comp (by fun_prop) (fun _ ht => affine_mem_cell a w hw ht)
  have h := fourteenQuadrature_fourteenth_order_l1_bound_on hm hg
  have hd : (∫ t in (0 : ℝ)..1,
      |iteratedDerivWithin 14 (fun u => f (a+w*u)) (Set.Icc (0 : ℝ) 1) t|) =
      w^14*(∫ t in (0 : ℝ)..1, |iteratedDerivWithin 14 f (Set.Icc a (a+w)) (a+w*t)|) := by
    rw [← intervalIntegral.integral_const_mul]
    apply intervalIntegral.integral_congr
    intro t ht
    rw [Set.uIcc_of_le (by norm_num : (0 : ℝ) ≤ 1)] at ht
    dsimp only
    rw [iteratedDerivWithin_affine_cell a w hw hf ht, abs_mul,
      abs_of_nonneg (by positivity : 0 ≤ w^14)]
  have hi : (∫ x in a..a+w, f x) = w*(∫ t in (0 : ℝ)..1, f (a+w*t)) := by
    symm
    simpa only [smul_eq_mul, mul_zero, mul_one, add_zero, zero_add] using
      intervalIntegral.smul_integral_comp_add_mul (a := (0 : ℝ)) (b := 1) f w a
  have hj : (∫ x in a..a+w, |iteratedDerivWithin 14 f (Set.Icc a (a+w)) x|) =
      w*(∫ t in (0 : ℝ)..1, |iteratedDerivWithin 14 f (Set.Icc a (a+w)) (a+w*t)|) := by
    symm
    simpa only [smul_eq_mul, mul_zero, mul_one, add_zero, zero_add] using
      intervalIntegral.smul_integral_comp_add_mul (a := (0 : ℝ)) (b := 1)
        (fun x => |iteratedDerivWithin 14 f (Set.Icc a (a+w)) x|) w a
  rw [hd] at h
  rw [hi, hj, ← mul_sub, abs_mul, abs_of_pos hw]
  calc
    _ ≤ w*(((10^24)/(m : ℝ)^14)*(w^14*(∫ t in (0 : ℝ)..1,
        |iteratedDerivWithin 14 f (Set.Icc a (a+w)) (a+w*t)|))) :=
      mul_le_mul_of_nonneg_left h hw.le
    _ = _ := by ring


end SphericalRiesz.Boundary
end
end
