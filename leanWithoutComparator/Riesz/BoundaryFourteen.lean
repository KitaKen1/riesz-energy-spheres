  rw [hq, hi, fourteenQuadrature_peano_error_identity hm a g hg]
  apply intervalIntegral.integral_congr
  intro t ht
  rw [Set.uIcc_of_le (by norm_num : (0 : ℝ) ≤ 1)] at ht
  dsimp only [g]
