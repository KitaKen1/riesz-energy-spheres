/-! A finite Peano certificate for the actual fourteenth-order rule.
The coarse constant is intentional: only independence of the mesh size matters. -/
set_option autoImplicit false
set_option maxHeartbeats 2000000
noncomputable section
namespace SphericalRiesz.Boundary

def positiveThirteenth (x : ℝ) : ℝ := (max x 0)^13

def fourteenUnscaledPeanoKernel (m : ℕ) (z : ℝ) : ℝ :=
  ((∑ i : Fin 24, positiveThirteenth (fourteenStripNode i-z)) +
    (∑ j ∈ Finset.range (m-48), positiveThirteenth ((j:ℝ)+24+1/2-z)) +
    (∑ i : Fin 24, positiveThirteenth ((m:ℝ)-fourteenStripNode i-z)) - ((m:ℝ)-z)^14/14)/6227020800

def fourteenMomentDefect : ℝ := fourteenStripPowerSum 13-fourteenMidpointPrimitive 13 24

theorem fourteen_right_thirteenth_sum (u : ℝ) :
    (∑ i : Fin 24,(u-fourteenStripNode i)^13) =
      u^14/14-fourteenMidpointPrimitive 13 (u-24)-fourteenMomentDefect := by
  have heq (x : ℝ) : (u-x)^13 =
    (1:ℝ)*u^13*x^0 + (-13:ℝ)*u^12*x^1 + (78:ℝ)*u^11*x^2 + (-286:ℝ)*u^10*x^3 + (715:ℝ)*u^9*x^4 + (-1287:ℝ)*u^8*x^5 + (1716:ℝ)*u^7*x^6 + (-1716:ℝ)*u^6*x^7 + (1287:ℝ)*u^5*x^8 + (-715:ℝ)*u^4*x^9 + (286:ℝ)*u^3*x^10 + (-78:ℝ)*u^2*x^11 + (13:ℝ)*u^1*x^12 + (-1:ℝ)*u^0*x^13 := by ring
  simp only [heq,Finset.sum_add_distrib,← Finset.mul_sum,← fourteenStripPowerSum_eq]
  norm_num [fourteenMomentDefect,fourteenMidpointPrimitive,
    fourteenStripPowerSum_0, fourteenStripPowerSum_1, fourteenStripPowerSum_2, fourteenStripPowerSum_3, fourteenStripPowerSum_4, fourteenStripPowerSum_5, fourteenStripPowerSum_6, fourteenStripPowerSum_7, fourteenStripPowerSum_8, fourteenStripPowerSum_9, fourteenStripPowerSum_10, fourteenStripPowerSum_11, fourteenStripPowerSum_12]
  ring
theorem fourteenUnscaledPeanoKernel_left_formula {m : ℕ} (hm : 48 ≤ m) {z : ℝ} (hz : z ≤ 24) :
    fourteenUnscaledPeanoKernel m z =
      (-fourteenMomentDefect - fourteenMidpointPrimitive 13 (24-z) +
        ∑ i : Fin 24, positiveThirteenth (fourteenStripNode i-z))/6227020800 := by
  have hm' : (48 : ℝ) ≤ m := by exact_mod_cast hm
  have hmiddle (j : ℕ) : positiveThirteenth ((j : ℝ)+24+1/2-z) =
      ((j : ℝ)+24+1/2-z)^13 := by
    unfold positiveThirteenth
    have hj : (0 : ℝ) ≤ j := by positivity
    rw [max_eq_left (by linarith)]
  have hright (i : Fin 24) : positiveThirteenth ((m : ℝ)-fourteenStripNode i-z) =
      ((m : ℝ)-fourteenStripNode i-z)^13 := by
    unfold positiveThirteenth
    have hi := (fourteenStripNode_between i).2
    rw [max_eq_left (by linarith)]
  have hmid : (∑ j ∈ Finset.range (m-48), ((j : ℝ)+24+1/2-z)^13) =
      fourteenMidpointPrimitive 13 (((m-48 : ℕ) : ℝ)+24-z) - fourteenMidpointPrimitive 13 (24-z) := by
    calc
      _ = ∑ j ∈ Finset.range (m-48), ((j : ℝ)+(24-z)+1/2)^13 := by
        apply Finset.sum_congr rfl
        intro j _
        congr 1
        ring
      _ = fourteenMidpointPrimitive 13 (((m-48 : ℕ) : ℝ)+(24-z)) - fourteenMidpointPrimitive 13 (24-z) :=
        fourteen_shifted_midpoint_sum (13 : Fin 14) (24-z) (m-48)
      _ = _ := by congr 2; ring
  have hn : ((m-48 : ℕ) : ℝ) = (m : ℝ)-48 := by
    rw [Nat.cast_sub hm]; norm_num
  unfold fourteenUnscaledPeanoKernel
  simp_rw [hmiddle, hright]
  rw [hmid]
  have hr : (∑ i : Fin 24, ((m : ℝ)-fourteenStripNode i-z)^13) =
      ∑ i : Fin 24, (((m : ℝ)-z)-fourteenStripNode i)^13 := by
    apply Finset.sum_congr rfl
    intro i _
    congr 1
    ring
  rw [hr, fourteen_right_thirteenth_sum, hn]
  norm_num [fourteenMidpointPrimitive, fourteenMomentDefect]
  ring

theorem fourteenUnscaledPeanoKernel_right_formula {m : ℕ} (hm : 48 ≤ m)
    {z : ℝ} (hz : z ≤ 24) : fourteenUnscaledPeanoKernel m ((m : ℝ)-z) =
      ((∑ i : Fin 24, positiveThirteenth (z-fourteenStripNode i))-z^14/14)/6227020800 := by
  have hm' : (48 : ℝ) ≤ m := by exact_mod_cast hm
  have hl : (∑ i : Fin 24, positiveThirteenth (fourteenStripNode i-((m : ℝ)-z))) = 0 := by
    apply Finset.sum_eq_zero
    intro i _
    have hi := (fourteenStripNode_between i).2
    simp [positiveThirteenth, max_eq_right (by linarith : fourteenStripNode i-((m : ℝ)-z) ≤ 0)]
  have hmid : (∑ j ∈ Finset.range (m-48),
      positiveThirteenth ((j : ℝ)+24+1/2-((m : ℝ)-z))) = 0 := by
    apply Finset.sum_eq_zero
    intro j hj
    have hj' : (j : ℝ)+1 ≤ ((m-48 : ℕ) : ℝ) := by
      have hjn : j < m-48 := Finset.mem_range.mp hj
      exact_mod_cast (by omega : j+1 ≤ m-48)
    rw [Nat.cast_sub hm] at hj'
    norm_num at hj'
    unfold positiveThirteenth
    rw [max_eq_right (by linarith : (j : ℝ)+24+1/2-((m : ℝ)-z) ≤ 0)]
    norm_num
  have hr (i : Fin 24) : positiveThirteenth ((m : ℝ)-fourteenStripNode i-((m : ℝ)-z)) =
      positiveThirteenth (z-fourteenStripNode i) := by congr 1; ring
  unfold fourteenUnscaledPeanoKernel
  rw [hl, hmid]
  simp_rw [hr]
  ring

theorem fourteenUnscaledPeanoKernel_interior_formula (a b : ℕ) {u : ℝ}
    (hu : u ∈ Set.Icc (0 : ℝ) 1) :
    fourteenUnscaledPeanoKernel (49+a+b) (24+(a : ℝ)+u) =
      (-fourteenMomentDefect - fourteenMidpointPrimitive 13 (1-u) + positiveThirteenth (1/2-u))/6227020800 := by
  have ha0 : (0 : ℝ) ≤ a := by positivity
  have hb0 : (0 : ℝ) ≤ b := by positivity
  have hl : (∑ i : Fin 24, positiveThirteenth (fourteenStripNode i-(24+(a : ℝ)+u))) = 0 := by
    apply Finset.sum_eq_zero
    intro i _
    have hi := (fourteenStripNode_between i).2
    unfold positiveThirteenth
    rw [max_eq_right (by linarith [hu.1])]
    norm_num
  have hn : (49+a+b : ℕ)-48 = a+(b+1) := by omega
  have hprefix : (∑ j ∈ Finset.range a,
      positiveThirteenth ((j : ℝ)+24+1/2-(24+(a : ℝ)+u))) = 0 := by
    apply Finset.sum_eq_zero
    intro j hj
    have hj' : (j : ℝ)+1 ≤ a := by
      have hjn := Finset.mem_range.mp hj
      exact_mod_cast (by omega : j+1 ≤ a)
    unfold positiveThirteenth
    rw [max_eq_right (by linarith [hu.1])]
    norm_num
  have htail (j : ℕ) : positiveThirteenth (((a+j+1 : ℕ) : ℝ)+24+1/2-(24+(a : ℝ)+u)) =
      ((j : ℝ)+(1-u)+1/2)^13 := by
    push_cast
    have heq : (a : ℝ)+j+1+24+1/2-(24+(a : ℝ)+u) = (j : ℝ)+(1-u)+1/2 := by ring
    rw [heq]
    unfold positiveThirteenth
    have hj0 : (0 : ℝ) ≤ j := by positivity
    rw [max_eq_left (by linarith [hu.2])]
  have hfirst : positiveThirteenth (((a+0 : ℕ) : ℝ)+24+1/2-(24+(a : ℝ)+u)) =
      positiveThirteenth (1/2-u) := by congr 1; push_cast; ring
  have hmid : (∑ j ∈ Finset.range ((49+a+b : ℕ)-48),
      positiveThirteenth ((j : ℝ)+24+1/2-(24+(a : ℝ)+u))) =
      positiveThirteenth (1/2-u) + fourteenMidpointPrimitive 13 ((b : ℝ)+1-u) -
        fourteenMidpointPrimitive 13 (1-u) := by
    rw [hn, Finset.sum_range_add, hprefix, zero_add, Finset.sum_range_succ']
    simp_rw [show ∀ j : ℕ, a+(j+1) = a+j+1 from fun j => by omega, htail]
    have hsum : (∑ j ∈ Finset.range b, ((j : ℝ)+(1-u)+1/2)^13) =
        fourteenMidpointPrimitive 13 ((b : ℝ)+(1-u)) - fourteenMidpointPrimitive 13 (1-u) :=
      fourteen_shifted_midpoint_sum (13 : Fin 14) (1-u) b
    rw [hfirst, hsum, show (b : ℝ)+(1-u) = (b : ℝ)+1-u by ring]
    ring
  have hr (i : Fin 24) :
      positiveThirteenth (((49+a+b : ℕ) : ℝ)-fourteenStripNode i-(24+(a : ℝ)+u)) =
        ((25+(b : ℝ)-u)-fourteenStripNode i)^13 := by
    have hi := (fourteenStripNode_between i).2
    have heq : ((49+a+b : ℕ) : ℝ)-fourteenStripNode i-(24+(a : ℝ)+u) =
        (25+(b : ℝ)-u)-fourteenStripNode i := by push_cast; ring
    rw [heq]
    unfold positiveThirteenth
    rw [max_eq_left (by linarith [hu.2])]
  unfold fourteenUnscaledPeanoKernel
  rw [hl, hmid]
  simp_rw [hr]
  rw [fourteen_right_thirteenth_sum]
  push_cast
  norm_num [fourteenMidpointPrimitive, fourteenMomentDefect]
  ring


private theorem fourteen_power_bound {x : ℝ} (hx : x ∈ Set.Icc (0:ℝ) 24) {k : ℕ} (hk : k ≤ 14) :
    |x^k| ≤ (24:ℝ)^14 := by
  rw [abs_of_nonneg (pow_nonneg hx.1 _)]
  calc
    x^k ≤ (24:ℝ)^k := pow_le_pow_left₀ hx.1 hx.2 k
    _ ≤ (24:ℝ)^14 := pow_le_pow_right₀ (by norm_num) hk

private def fourteenPrimitiveCoefficients : Fin 7 → ℝ :=
  ![1414477/860160,-33215/6144,18161/2560,-4433/896,1001/480,-13/24,1/14]

theorem fourteenMidpointPrimitive_thirteen_bound {x : ℝ} (hx : x ∈ Set.Icc (0:ℝ) 24) :
    |fourteenMidpointPrimitive 13 x| ≤ (10:ℝ)^22 := by
  have heq : fourteenMidpointPrimitive 13 x =
      ∑ i : Fin 7,fourteenPrimitiveCoefficients i*x^(2*(i.val+1)) := by
    norm_num [fourteenMidpointPrimitive,fourteenPrimitiveCoefficients,Fin.sum_univ_succ]
    ring
  rw [heq]
  calc
    _ ≤ ∑ i : Fin 7, |fourteenPrimitiveCoefficients i*x^(2*(i.val+1))| := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ i : Fin 7, (8:ℝ)*24^14 := by
      apply Finset.sum_le_sum
      intro i _
      rw [abs_mul]
      apply mul_le_mul
      · fin_cases i <;> norm_num [fourteenPrimitiveCoefficients]
      · exact fourteen_power_bound hx (by have := i.isLt; omega)
      · exact abs_nonneg _
      · norm_num
    _ ≤ _ := by norm_num

theorem fourteenMomentDefect_bound : |fourteenMomentDefect| ≤ (10:ℝ)^23 := by
  have hs : |fourteenStripPowerSum 13| ≤ (24:ℝ)^14 := by
    unfold fourteenStripPowerSum
    calc
      _ ≤ ∑ i : Fin 24,|fourteenStripNode i^13| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ i : Fin 24,(24:ℝ)^13 := by
        apply Finset.sum_le_sum
        intro i _
        have hi := fourteenStripNode_between i
        rw [abs_of_nonneg (pow_nonneg hi.1.le _)]
        exact pow_le_pow_left₀ hi.1.le hi.2.le 13
      _ = _ := by norm_num
  have hp := fourteenMidpointPrimitive_thirteen_bound (x:=24) (by constructor <;> norm_num)
  unfold fourteenMomentDefect
  exact (abs_sub _ _).trans (by norm_num at hs hp ⊢; linarith)

theorem fourteenUnscaledPeanoKernel_left_bound {m : ℕ} (hm : 48 ≤ m)
    {z : ℝ} (hz : z ∈ Set.Icc (0:ℝ) 24) : |fourteenUnscaledPeanoKernel m z| ≤ (10:ℝ)^24 := by
  have hs : |∑ i : Fin 24,positiveThirteenth (fourteenStripNode i-z)| ≤ (24:ℝ)^14 := by
    calc
      _ ≤ ∑ i : Fin 24,|positiveThirteenth (fourteenStripNode i-z)| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ i : Fin 24,(24:ℝ)^13 := by
        apply Finset.sum_le_sum
        intro i _
        have hi := fourteenStripNode_between i
        rw [abs_of_nonneg (by unfold positiveThirteenth; positivity)]
        unfold positiveThirteenth
        gcongr
        exact max_le (by linarith [hz.1]) (by norm_num)
      _ = _ := by norm_num
  have hp := fourteenMidpointPrimitive_thirteen_bound (x:=24-z) ⟨by linarith [hz.2],by linarith [hz.1]⟩
  have hd := fourteenMomentDefect_bound
  rw [fourteenUnscaledPeanoKernel_left_formula hm hz.2,abs_div]
  norm_num
  have h1 := abs_sub (-fourteenMomentDefect) (fourteenMidpointPrimitive 13 (24-z))
  have h2 := abs_add_le (-fourteenMomentDefect-fourteenMidpointPrimitive 13 (24-z))
    (∑ i : Fin 24,positiveThirteenth (fourteenStripNode i-z))
  rw [abs_neg] at h1
  norm_num at hs hp hd ⊢
  linarith

theorem fourteenUnscaledPeanoKernel_right_bound {m : ℕ} (hm : 48 ≤ m)
    {z : ℝ} (hz : z ∈ Set.Icc (0:ℝ) 24) :
    |fourteenUnscaledPeanoKernel m ((m:ℝ)-z)| ≤ (10:ℝ)^24 := by
  have hs : |∑ i : Fin 24,positiveThirteenth (z-fourteenStripNode i)| ≤ (24:ℝ)^14 := by
    calc
      _ ≤ ∑ i : Fin 24,|positiveThirteenth (z-fourteenStripNode i)| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ i : Fin 24,(24:ℝ)^13 := by
        apply Finset.sum_le_sum
        intro i _
        have hi := fourteenStripNode_between i
        rw [abs_of_nonneg (by unfold positiveThirteenth; positivity)]
        unfold positiveThirteenth
        gcongr
        exact max_le (by linarith [hz.2]) (by norm_num)
      _ = _ := by norm_num
  have hp := fourteen_power_bound hz (k:=14) (by omega)
  rw [fourteenUnscaledPeanoKernel_right_formula hm hz.2,abs_div]
  norm_num
  have h := abs_sub (∑ i : Fin 24,positiveThirteenth (z-fourteenStripNode i)) (z^14/14)
  rw [abs_div] at h
  norm_num at hs hp h ⊢
  linarith

theorem fourteenUnscaledPeanoKernel_interior_bound (a b : ℕ) {u : ℝ}
    (hu : u ∈ Set.Icc (0:ℝ) 1) :
    |fourteenUnscaledPeanoKernel (49+a+b) (24+(a:ℝ)+u)| ≤ (10:ℝ)^24 := by
  have hp := fourteenMidpointPrimitive_thirteen_bound (x:=1-u) ⟨by linarith [hu.2],by linarith [hu.1]⟩
  have hd := fourteenMomentDefect_bound
  have hs : |positiveThirteenth (1/2-u)| ≤ (24:ℝ)^13 := by
    rw [abs_of_nonneg (by unfold positiveThirteenth; positivity)]
    unfold positiveThirteenth
    gcongr
    exact max_le (by linarith [hu.1]) (by norm_num)
  rw [fourteenUnscaledPeanoKernel_interior_formula a b hu,abs_div]
  norm_num
  have h1 := abs_sub (-fourteenMomentDefect) (fourteenMidpointPrimitive 13 (1-u))
  have h2 := abs_add_le (-fourteenMomentDefect-fourteenMidpointPrimitive 13 (1-u)) (positiveThirteenth (1/2-u))
  rw [abs_neg] at h1
  norm_num at hs hp hd ⊢
  linarith
theorem fourteenUnscaledPeanoKernel_bound {m : ℕ} (hm : 48 ≤ m) {z : ℝ}
    (hz : z ∈ Set.Icc (0 : ℝ) m) : |fourteenUnscaledPeanoKernel m z| ≤ (10^24) := by
  by_cases hleft : z ≤ 24
  · exact fourteenUnscaledPeanoKernel_left_bound hm ⟨hz.1, hleft⟩
  by_cases hright : (m : ℝ)-24 ≤ z
  · have h := fourteenUnscaledPeanoKernel_right_bound hm
      (z := (m : ℝ)-z) ⟨by linarith [hz.2], by linarith⟩
    rw [show (m : ℝ)-((m : ℝ)-z) = z by ring] at h
    exact h
  let k : ℕ := Nat.floor z
  have hk0 : (k : ℝ) ≤ z := Nat.floor_le hz.1
  have hk1 : z < (k : ℝ)+1 := Nat.lt_floor_add_one z
  have hk4 : 24 ≤ k := (Nat.le_floor_iff hz.1).mpr (by norm_num; linarith)
  have hklt : k < m-24 := by
    apply (Nat.floor_lt hz.1).mpr
    rw [Nat.cast_sub (by omega : 24 ≤ m)]
    norm_num
    linarith
  have hu : z-(k : ℝ) ∈ Set.Icc (0 : ℝ) 1 := ⟨by linarith, by linarith⟩
  have hmrepr : 49+(k-24)+(m-k-25) = m := by omega
  have hzrepr : 24+((k-24 : ℕ) : ℝ)+(z-(k : ℝ)) = z := by
    rw [Nat.cast_sub hk4]
    norm_num
  have h := fourteenUnscaledPeanoKernel_interior_bound (k-24) (m-k-25) hu
  rw [hmrepr, hzrepr] at h
  exact h

def fourteenUnitPeanoKernel (m : ℕ) (t : ℝ) : ℝ :=
  (fourteenQuadrature m (fun x => positiveThirteenth (x-t)) - (1-t)^14/14)/6227020800

theorem fourteenUnitPeanoKernel_scale {m : ℕ} (hm : 48 ≤ m) (z : ℝ) :
    fourteenUnitPeanoKernel m (z/m) = fourteenUnscaledPeanoKernel m z / (m : ℝ)^14 := by
  have hm0 : (0 : ℝ) < m := by exact_mod_cast (by omega : 0 < m)
  have hf (x : ℝ) : positiveThirteenth (x/m-z/m) = positiveThirteenth (x-z)/(m : ℝ)^13 := by
    unfold positiveThirteenth
    have hmax : max ((x-z)/m) 0 = max (x-z) 0 / m := by
      simpa using max_div_div_right hm0.le (x-z) 0
    rw [← sub_div, hmax, div_pow]
  have h1 : (1 : ℝ)-z/m = ((m : ℝ)-z)/m := by field_simp
  unfold fourteenUnitPeanoKernel fourteenQuadrature fourteenUnscaledPeanoKernel
  simp_rw [hf, ← Finset.sum_div]
  rw [h1, div_pow]
  simp only [sub_eq_add_neg, add_comm, add_left_comm, add_assoc]
  field_simp [hm0.ne']
  ring

theorem fourteenUnitPeanoKernel_bound {m : ℕ} (hm : 48 ≤ m) {t : ℝ}
    (ht : t ∈ Set.Icc (0 : ℝ) 1) : |fourteenUnitPeanoKernel m t| ≤ (10^24)/(m : ℝ)^14 := by
  have hm0 : (0 : ℝ) < m := by exact_mod_cast (by omega : 0 < m)
  have hz : (m : ℝ)*t ∈ Set.Icc (0 : ℝ) m := by
    constructor
    · exact mul_nonneg hm0.le ht.1
    · nlinarith [ht.2]
  have hscale : fourteenUnitPeanoKernel m t = fourteenUnscaledPeanoKernel m ((m : ℝ)*t)/(m : ℝ)^14 := by
    have h := fourteenUnitPeanoKernel_scale hm ((m : ℝ)*t)
    rw [mul_div_cancel_left₀ _ hm0.ne'] at h
    exact h
  have hden : 0 ≤ (m : ℝ)^14 := by positivity
  rw [hscale, abs_div, abs_of_nonneg hden]
  exact div_le_div_of_nonneg_right (fourteenUnscaledPeanoKernel_bound hm hz) hden

theorem fourteenUnitPeanoKernel_continuous (m : ℕ) : Continuous (fourteenUnitPeanoKernel m) := by
  unfold fourteenUnitPeanoKernel fourteenQuadrature positiveThirteenth
  fun_prop

/-- This estimates an actual kernel integral. Identifying it with a C⁶ fourteenQuadrature error is separate. -/
theorem fourteenUnitPeanoKernel_weighted_integral_bound {m : ℕ} (hm : 48 ≤ m)
    (g : ℝ → ℝ) (M : ℝ) (hg : ∀ t ∈ Set.Icc (0 : ℝ) 1, |g t| ≤ M) :
    |∫ t in (0 : ℝ)..1, fourteenUnitPeanoKernel m t*g t| ≤ ((10^24)/(m : ℝ)^14)*M := by
  have h : ∀ t ∈ Set.Icc (0 : ℝ) 1,
      |fourteenUnitPeanoKernel m t*g t| ≤ ((10^24)/(m : ℝ)^14)*M := by
    intro t ht
    rw [abs_mul]
    exact mul_le_mul (fourteenUnitPeanoKernel_bound hm ht) (hg t ht) (abs_nonneg _) (by positivity)
  have hi := intervalIntegral.norm_integral_le_of_norm_le_const
