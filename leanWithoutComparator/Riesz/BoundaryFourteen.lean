/-! # A fourteenth-order positive equal-weight boundary rule

Twelve of the first 24 midpoints of the mesh are moved (cells 0,1,3,5,8,11,14,17,19,21,22,23,
Chebyshev-like spacing, every displacement below a tenth of a cell), and symmetrically at the
right end.  The twelve moved nodes are the roots of an explicit degree-12 integer polynomial,
isolated in their quarter cells by sign changes; their power sums of orders 1..12 are computed by
Newton's identities.  With all other nodes at the midpoints the rule has equal weights `1/m`,
integrates polynomials of degree at most 13 exactly, and its error is at most
`10^24 m^(-14) ∫ |f^(14)|` (Peano kernel), also in tensor form on the unit cube of any dimension
and with a product envelope.

The parts are the order-fourteen forms of the checked order-twelve modules
`BoundaryTwelveNodes`, `…Moments`, `…Quadrature`, `…Peano`, `…LocalError`, `…L1Error`, `…Tensor`,
`…Envelope`, `…NodeGeometry`, `…LocalizedError`; the numeric data are generated by
`scripts/gen_boundary_fourteen.py` and re-proved here.  Order fourteen is what negative
exponents on `S²⁴` need: a rule of order `k` gives a foreground Gaussian defect of size
`N α^(k-12)` at mesoscopic scales. -/

section


/-! Actual real nodes for the fourteenth-order equal-weight boundary correction.
The twelve modified midpoint labels are 0,1,3,5,8,11,14,17,19,21,22,23 within a 24-cell strip
(Chebyshev-like spacing keeps every displacement below a tenth of a cell).
Root existence and quarter-cell localization are proved here.  The twelve power-sum
identities, the full corrected rule and its fourteenth-order error bound are separate. -/

set_option autoImplicit false
set_option maxHeartbeats 2000000
noncomputable section
namespace SphericalRiesz.Boundary

def fourteenCandidateP (x : ℝ) : ℝ :=
  39797268543821419527536640000*x^12
  - 5967932062050553703316848640000*x^11
  + 394400915132646278273307770880000*x^10
  - 15105230179713686587092076855296000*x^9
  + 370859241326839829669913827475456000*x^8
  - 6096472475818010458475574929129472000*x^7
  + 68048854619303882754173669104366387200*x^6
  - 512125987223843818982931947592823603200*x^5
  + 2528224341075879905139876761184409190400*x^4
  - 7760171102434405612950466998058479759360*x^3
  + 13455313218097935797501540146436673288960*x^2
  - 10969262263760929236495546270112222377120*x
  + 2709204514402478681689254207272447614051

def fourteenCandidateLabel : Fin 12 → ℕ := ![0,1,3,5,8,11,14,17,19,21,22,23]

def fourteenCandidateLower (i : Fin 12) : ℝ := (fourteenCandidateLabel i:ℝ)+1/4
def fourteenCandidateUpper (i : Fin 12) : ℝ := (fourteenCandidateLabel i:ℝ)+3/4

theorem fourteenCandidateP_continuous : Continuous fourteenCandidateP := by
  unfold fourteenCandidateP
  fun_prop

theorem fourteenCandidateNode_exists (i : Fin 12) :
    ∃ x, fourteenCandidateLower i < x ∧ x < fourteenCandidateUpper i ∧ fourteenCandidateP x = 0 := by
  have hab : fourteenCandidateLower i < fourteenCandidateUpper i := by
    unfold fourteenCandidateLower fourteenCandidateUpper
    linarith
  have hs : (fourteenCandidateP (fourteenCandidateLower i) < 0 ∧
      0 < fourteenCandidateP (fourteenCandidateUpper i)) ∨
      (fourteenCandidateP (fourteenCandidateUpper i) < 0 ∧
      0 < fourteenCandidateP (fourteenCandidateLower i)) := by
    fin_cases i <;>
      norm_num [fourteenCandidateLower,fourteenCandidateUpper,fourteenCandidateLabel,fourteenCandidateP]
  rcases hs with hs | hs
  · obtain ⟨x,hx,hz⟩ := intermediate_value_Ioo hab.le fourteenCandidateP_continuous.continuousOn hs
    exact ⟨x,hx.1,hx.2,hz⟩
  · obtain ⟨x,hx,hz⟩ := intermediate_value_Ioo' hab.le fourteenCandidateP_continuous.continuousOn hs
    exact ⟨x,hx.1,hx.2,hz⟩

def fourteenCandidateNode (i : Fin 12) : ℝ := Classical.choose (fourteenCandidateNode_exists i)

theorem fourteenCandidateNode_spec (i : Fin 12) :
    fourteenCandidateLower i < fourteenCandidateNode i ∧
      fourteenCandidateNode i < fourteenCandidateUpper i ∧ fourteenCandidateP (fourteenCandidateNode i) = 0 :=
  Classical.choose_spec (fourteenCandidateNode_exists i)

theorem fourteenCandidateLabel_succ_le {i j : Fin 12} (hij : i < j) :
    fourteenCandidateLabel i+1 ≤ fourteenCandidateLabel j := by
  revert i j
  decide

theorem fourteenCandidateNode_strictMono : StrictMono fourteenCandidateNode := by
  intro i j hij
  have hi := (fourteenCandidateNode_spec i).2.1
  have hj := (fourteenCandidateNode_spec j).1
  have hle : (fourteenCandidateLabel i:ℝ)+1 ≤ (fourteenCandidateLabel j:ℝ) := by
    exact_mod_cast fourteenCandidateLabel_succ_le hij
  dsimp [fourteenCandidateLower,fourteenCandidateUpper] at hi hj
  linarith

theorem fourteenCandidateNode_injective : Function.Injective fourteenCandidateNode :=
  fourteenCandidateNode_strictMono.injective

theorem fourteenCandidateNode_close_to_label (i : Fin 12) :
    |fourteenCandidateNode i-(fourteenCandidateLabel i:ℝ)-1/2| < 1/4 := by
  have h := fourteenCandidateNode_spec i
  simp only [fourteenCandidateLower,fourteenCandidateUpper] at h
  rw [abs_lt]
  constructor <;> linarith

end SphericalRiesz.Boundary
end
end
