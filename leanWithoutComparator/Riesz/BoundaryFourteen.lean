/-! Actual tensor points and fourteenth-order error in any finite dimension.
This reuses the original pure-slice induction without mixed derivatives. -/
set_option autoImplicit false
noncomputable section
open MeasureTheory
namespace SphericalRiesz.Boundary

theorem fourteenQuadrature_const {m : ℕ} (hm : 48 ≤ m) (c : ℝ) :
    fourteenQuadrature m (fun _ => c) = c := by
  have h : fourteenQuadrature m (fun _ => (1 : ℝ)) = 1 := by
    simpa using fourteenQuadrature_monomial hm (0 : Fin 14)
  simpa using (fourteenQuadrature_mul_const m c (fun _ => 1)).trans (by rw [h, mul_one])

theorem fourteenQuadrature_sub (m : ℕ) (f g : ℝ → ℝ) :
    fourteenQuadrature m (fun x => f x-g x) = fourteenQuadrature m f-fourteenQuadrature m g := by
  simp only [fourteenQuadrature, Finset.sum_sub_distrib]
  ring

theorem fourteenQuadrature_mono {m : ℕ} (hm : 48 ≤ m) {f g : ℝ → ℝ}
    (h : ∀ x ∈ Set.Icc (0 : ℝ) 1, f x ≤ g x) : fourteenQuadrature m f ≤ fourteenQuadrature m g := by
  rw [fourteenQuadrature_as_node_sum, fourteenQuadrature_as_node_sum]
  apply div_le_div_of_nonneg_right _ (by positivity)
  apply Finset.sum_le_sum
  intro i _
  exact h _ (Set.Ioo_subset_Icc_self (fourteenRuleNode_mem_unit hm i))

theorem fourteenQuadrature_abs_le {m : ℕ} (hm : 48 ≤ m) {f : ℝ → ℝ} {M : ℝ}
    (h : ∀ x ∈ Set.Icc (0 : ℝ) 1, |f x| ≤ M) : |fourteenQuadrature m f| ≤ M := by
  apply abs_le.mpr
  constructor
  · have hl := fourteenQuadrature_mono hm (f := fun _ => -M) (g := f)
      (fun x hx => (abs_le.mp (h x hx)).1)
    simpa only [fourteenQuadrature_const hm] using hl
  · have hu := fourteenQuadrature_mono hm (f := f) (g := fun _ => M)
      (fun x hx => (abs_le.mp (h x hx)).2)
    simpa only [fourteenQuadrature_const hm] using hu

def fourteenCubeQuadrature : (d : ℕ) → ℕ → ((Fin d → ℝ) → ℝ) → ℝ
  | 0, _, f => f Fin.elim0
  | d+1, m, f => fourteenCubeQuadrature d m (fun v => fourteenQuadrature m (fun t => f (Fin.cons t v)))

theorem fourteenCubeQuadrature_abs_le (d m : ℕ) (hm : 48 ≤ m) (f : (Fin d → ℝ) → ℝ) (M : ℝ)
    (hM : ∀ v ∈ UnitCube d, |f v| ≤ M) : |fourteenCubeQuadrature d m f| ≤ M := by
  induction d with
  | zero => exact hM Fin.elim0 (fun i => Fin.elim0 i)
  | succ d ih =>
    apply ih
    intro v hv
    exact fourteenQuadrature_abs_le hm (fun t ht => hM _ (cons_mem_unitCube ht hv))

theorem fourteenCubeQuadrature_sub (d m : ℕ) (f g : (Fin d → ℝ) → ℝ) :
    fourteenCubeQuadrature d m (fun v => f v-g v) = fourteenCubeQuadrature d m f-fourteenCubeQuadrature d m g := by
  induction d with
  | zero => rfl
  | succ d ih => simp only [fourteenCubeQuadrature, fourteenQuadrature_sub]; exact ih _ _

theorem fourteenCubeQuadrature_congr (d m : ℕ) {f g : (Fin d → ℝ) → ℝ} (hm : 48 ≤ m)
    (hfg : Set.EqOn f g (UnitCube d)) : fourteenCubeQuadrature d m f = fourteenCubeQuadrature d m g := by
  induction d with
  | zero => exact hfg (fun i => Fin.elim0 i)
  | succ d ih =>
    apply ih
    intro v hv
    change fourteenQuadrature m (fun t => f (Fin.cons t v)) = fourteenQuadrature m (fun t => g (Fin.cons t v))
    rw [fourteenQuadrature_as_node_sum, fourteenQuadrature_as_node_sum]
    congr 1
    apply Finset.sum_congr rfl
    intro i _
    exact hfg (cons_mem_unitCube (Set.Ioo_subset_Icc_self (fourteenRuleNode_mem_unit hm i)) hv)

theorem continuous_fourteenQuadrature_param {X : Type*} [TopologicalSpace X]
    (m : ℕ) {F : X → ℝ → ℝ} (hF : Continuous (Function.uncurry F)) :
    Continuous (fun x => fourteenQuadrature m (F x)) := by
  simp only [fourteenQuadrature_as_node_sum]
  apply Continuous.div_const
  apply continuous_finsetSum
  intro i _
  exact hF.comp (continuous_id.prodMk continuous_const)

theorem contDiffOn_fourteenQuadrature_param (m n : ℕ) {F : ℝ → ℝ → ℝ} {s : Set ℝ}
    (hF : ∀ i : FourteenNodeIndex m, ContDiffOn ℝ n (fun x => F x (fourteenRuleNode m i)) s) :
    ContDiffOn ℝ n (fun x => fourteenQuadrature m (F x)) s := by
  simp only [fourteenQuadrature_as_node_sum]
  exact (ContDiffOn.sum (fun i _ => hF i)).div_const _

theorem iteratedDerivWithin_fourteenQuadrature_param (m n : ℕ) {F : ℝ → ℝ → ℝ}
    {s : Set ℝ} (hs : UniqueDiffOn ℝ s)
    (hF : ∀ i : FourteenNodeIndex m, ContDiffOn ℝ n (fun x => F x (fourteenRuleNode m i)) s)
    {x : ℝ} (hx : x ∈ s) :
    iteratedDerivWithin n (fun u => fourteenQuadrature m (F u)) s x =
      fourteenQuadrature m (fun z => iteratedDerivWithin n (fun u => F u z) s x) := by
  simp only [fourteenQuadrature_as_node_sum, div_eq_inv_mul]
  rw [iteratedDerivWithin_const_mul_field]
  congr 1
  exact iteratedDerivWithin_fun_sum hx hs (fun i _ => hF i x hx)

/-- Pure fourteenth slice derivatives suffice in every finite dimension. -/
theorem fourteenCubeQuadrature_fourteenth_order_bound (d : ℕ) {m : ℕ} (hm : 48 ≤ m)
    {f : (Fin d → ℝ) → ℝ} (hf : Continuous f)
    (hs : ∀ i v, v ∈ UnitCube d →
      ContDiffOn ℝ 14 (fun t => f (Function.update v i t)) (Set.Icc (0 : ℝ) 1))
    (M : Fin d → ℝ)
    (hM : ∀ i v, v ∈ UnitCube d → ∀ t ∈ Set.Icc (0 : ℝ) 1,
      |iteratedDerivWithin 14 (fun u => f (Function.update v i u))
        (Set.Icc (0 : ℝ) 1) t| ≤ M i) :
    |fourteenCubeQuadrature d m f-cubeIntegral d f| ≤ ((10^24)/(m : ℝ)^14)*(∑ i, M i) := by
  induction d with
  | zero => simp [fourteenCubeQuadrature, cubeIntegral]
  | succ d ih =>
    let q : (Fin d → ℝ) → ℝ := fun v => fourteenQuadrature m (fun t => f (Fin.cons t v))
    let a : (Fin d → ℝ) → ℝ := fun v => ∫ t in (0 : ℝ)..1, f (Fin.cons t v)
    have hq : Continuous q := continuous_fourteenQuadrature_param m (hf.comp (by fun_prop))
    have ha : Continuous a := continuous_unitIntegral_param (hf.comp (by fun_prop))
    have hsq : ∀ i v, v ∈ UnitCube d →
        ContDiffOn ℝ 14 (fun t => q (Function.update v i t)) (Set.Icc (0 : ℝ) 1) := by
      intro i v hv
      apply contDiffOn_fourteenQuadrature_param
      intro j
      simpa only [Nat.cast_ofNat, ← Fin.cons_update] using
        hs i.succ (Fin.cons (fourteenRuleNode m j) v)
          (cons_mem_unitCube (Set.Ioo_subset_Icc_self (fourteenRuleNode_mem_unit hm j)) hv)
    have hMq : ∀ i v, v ∈ UnitCube d → ∀ t ∈ Set.Icc (0 : ℝ) 1,
        |iteratedDerivWithin 14 (fun u => q (Function.update v i u))
          (Set.Icc (0 : ℝ) 1) t| ≤ M i.succ := by
      intro i v hv t ht
      have hsl : ∀ j : FourteenNodeIndex m, ContDiffOn ℝ 14
          (fun u => f (Fin.cons (fourteenRuleNode m j) (Function.update v i u)))
            (Set.Icc (0 : ℝ) 1) := by
        intro j
        simpa only [← Fin.cons_update] using
          hs i.succ (Fin.cons (fourteenRuleNode m j) v)
            (cons_mem_unitCube (Set.Ioo_subset_Icc_self (fourteenRuleNode_mem_unit hm j)) hv)
      dsimp only [q]
      rw [iteratedDerivWithin_fourteenQuadrature_param m 14 (uniqueDiffOn_Icc (by norm_num)) hsl ht]
      apply fourteenQuadrature_abs_le hm
      intro z hz
      simpa only [← Fin.cons_update] using
        hM i.succ (Fin.cons z v) (cons_mem_unitCube hz hv) t ht
    have hfirst := ih hq hsq (fun i => M i.succ) hMq
    have hhead : ∀ v ∈ UnitCube d, |q v-a v| ≤ ((10^24)/(m : ℝ)^14)*M 0 := by
      intro v hv
      have hz : (0 : ℝ) ∈ Set.Icc (0 : ℝ) 1 := by norm_num
      apply fourteenQuadrature_fourteenth_order_bound_on hm
      · simpa only [Fin.update_cons_zero] using
          hs 0 (Fin.cons 0 v) (cons_mem_unitCube hz hv)
      · intro t ht
        simpa only [Fin.update_cons_zero] using
          hM 0 (Fin.cons 0 v) (cons_mem_unitCube hz hv) t ht
    have hsecond : |cubeIntegral d q-cubeIntegral d a| ≤ ((10^24)/(m : ℝ)^14)*M 0 := by
      rw [← cubeIntegral_sub d q a hq ha]
      exact cubeIntegral_abs_le d _ _ hhead
    change |fourteenCubeQuadrature d m q-cubeIntegral d a| ≤ _
    calc
      |fourteenCubeQuadrature d m q-cubeIntegral d a| ≤
          |fourteenCubeQuadrature d m q-cubeIntegral d q| + |cubeIntegral d q-cubeIntegral d a| := by
        rw [show fourteenCubeQuadrature d m q-cubeIntegral d a =
          (fourteenCubeQuadrature d m q-cubeIntegral d q)+(cubeIntegral d q-cubeIntegral d a) by ring]
        exact abs_add_le _ _
      _ ≤ ((10^24)/(m : ℝ)^14)*(∑ i : Fin d, M i.succ)+((10^24)/(m : ℝ)^14)*M 0 := add_le_add hfirst hsecond
      _ = ((10^24)/(m : ℝ)^14)*(∑ i, M i) := by rw [Fin.sum_univ_succ]; ring

theorem fourteenCubeQuadrature_fourteenth_order_bound_on (d : ℕ) {m : ℕ} (hm : 48 ≤ m)
    {f : (Fin d → ℝ) → ℝ} (hf : ContinuousOn f (UnitCube d))
    (hs : ∀ i v, v ∈ UnitCube d →
      ContDiffOn ℝ 14 (fun t => f (Function.update v i t)) (Set.Icc (0 : ℝ) 1))
    (M : Fin d → ℝ)
    (hM : ∀ i v, v ∈ UnitCube d → ∀ t ∈ Set.Icc (0 : ℝ) 1,
      |iteratedDerivWithin 14 (fun u => f (Function.update v i u))
        (Set.Icc (0 : ℝ) 1) t| ≤ M i) :
    |fourteenCubeQuadrature d m f-cubeIntegral d f| ≤ ((10^24)/(m : ℝ)^14)*(∑ i, M i) := by
  let g : (Fin d → ℝ) → ℝ := fun v => f (cubeClamp d v)
  have hgf : Set.EqOn g f (UnitCube d) := fun v hv => by
    dsimp only [g]
    rw [cubeClamp_eq hv]
  have hslice (i : Fin d) (v : Fin d → ℝ) (hv : v ∈ UnitCube d) :
      Set.EqOn (fun t => g (Function.update v i t))
        (fun t => f (Function.update v i t)) (Set.Icc (0 : ℝ) 1) :=
    fun _ ht => hgf (update_mem_unitCube hv i ht)
  have hsg : ∀ i v, v ∈ UnitCube d →
      ContDiffOn ℝ 14 (fun t => g (Function.update v i t)) (Set.Icc (0 : ℝ) 1) :=
    fun i v hv => (hs i v hv).congr (hslice i v hv)
  have hMg : ∀ i v, v ∈ UnitCube d → ∀ t ∈ Set.Icc (0 : ℝ) 1,
      |iteratedDerivWithin 14 (fun u => g (Function.update v i u))
        (Set.Icc (0 : ℝ) 1) t| ≤ M i := by
    intro i v hv t ht
    rw [iteratedDerivWithin_congr (hslice i v hv) ht]
    exact hM i v hv t ht
  have h := fourteenCubeQuadrature_fourteenth_order_bound d hm (continuous_cube_extension hf) hsg M hMg
  rw [fourteenCubeQuadrature_congr d m hm hgf, cubeIntegral_congr d hgf] at h
  exact h


def fourteenCubeNode (d m : ℕ) (v : Fin d → FourteenNodeIndex m) : Fin d → ℝ :=
  fun i => fourteenRuleNode m (v i)

theorem fourteenCubeNode_card (d m : ℕ) (hm : 48 ≤ m) :
    Fintype.card (Fin d → FourteenNodeIndex m) = m^d := by
  rw [Fintype.card_pi_const, fourteenNodeIndex_card hm]

theorem fourteenCubeNode_injective (d m : ℕ) (hm : 48 ≤ m) : Function.Injective (fourteenCubeNode d m) := by
  intro v u h
  funext i
  exact fourteenRuleNode_injective hm (congrFun h i)

theorem fourteenCubeNode_mem_open (d m : ℕ) (hm : 48 ≤ m) (v : Fin d → FourteenNodeIndex m) :
    ∀ i, fourteenCubeNode d m v i ∈ Set.Ioo (0 : ℝ) 1 :=
  fun i => fourteenRuleNode_mem_unit hm (v i)

theorem fourteenCubeNode_cons (d m : ℕ) (j : FourteenNodeIndex m) (v : Fin d → FourteenNodeIndex m) :
    fourteenCubeNode (d+1) m (Fin.cons j v) = Fin.cons (fourteenRuleNode m j) (fourteenCubeNode d m v) := by
  funext i
  exact Fin.cases (by simp [fourteenCubeNode]) (fun k => by simp [fourteenCubeNode]) i

theorem fourteenCubeQuadrature_as_node_sum (d m : ℕ) (f : (Fin d → ℝ) → ℝ) :
    fourteenCubeQuadrature d m f =
      (∑ v : Fin d → FourteenNodeIndex m, f (fourteenCubeNode d m v))/(m : ℝ)^d := by
  induction d with
  | zero =>
    have h : ∀ v : Fin 0 → FourteenNodeIndex m, fourteenCubeNode 0 m v = Fin.elim0 :=
      fun _ => Subsingleton.elim _ _
    simp [fourteenCubeQuadrature, h]
  | succ d ih =>
    rw [fourteenCubeQuadrature, ih]
    simp_rw [fourteenQuadrature_as_node_sum]
    rw [← Finset.sum_div, div_div, ← pow_succ']
    congr 1
    have heq := (Fin.consEquiv (fun _ : Fin (d+1) => FourteenNodeIndex m)).sum_comp
      (fun v => f (fourteenCubeNode (d+1) m v))
    have hsum : (∑ v : Fin (d+1) → FourteenNodeIndex m, f (fourteenCubeNode (d+1) m v)) =
        ∑ j : FourteenNodeIndex m, ∑ v : Fin d → FourteenNodeIndex m,
          f (Fin.cons (fourteenRuleNode m j) (fourteenCubeNode d m v)) := by
      simpa only [Fin.consEquiv, Equiv.coe_fn_mk, Fintype.sum_prod_type, fourteenCubeNode_cons] using heq.symm
    rw [hsum, Finset.sum_comm]


end SphericalRiesz.Boundary
end
end
