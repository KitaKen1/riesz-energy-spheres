private theorem fourteenPairMonomial_eq (k : Fin 14) (m x : ℝ) :
    x^k.val+(m-x)^k.val=fourteenPairMonomial k m x := by
  fin_cases k <;> norm_num [fourteenPairMonomial] <;> ring

theorem fourteenStrip_pair_sum (k : Fin 14) (m : ℝ) :
    (∑ i : Fin 24, ((fourteenStripNode i)^k.val+(m-fourteenStripNode i)^k.val)) =
      fourteenPairFormula k m := by
  simp_rw [fourteenPairMonomial_eq]
  fin_cases k <;>
    simp only [fourteenPairMonomial, Finset.sum_add_distrib, ← Finset.mul_sum,
      ← fourteenStripPowerSum_eq] <;>
    norm_num [fourteenPairFormula, fourteenStripPowerSum_0, fourteenStripPowerSum_1, fourteenStripPowerSum_2, fourteenStripPowerSum_3, fourteenStripPowerSum_4, fourteenStripPowerSum_5, fourteenStripPowerSum_6, fourteenStripPowerSum_7, fourteenStripPowerSum_8, fourteenStripPowerSum_9, fourteenStripPowerSum_10, fourteenStripPowerSum_11, fourteenStripPowerSum_12]

abbrev FourteenNodeIndex (m : ℕ) := Fin 24 ⊕ (Fin (m-48) ⊕ Fin 24)

def fourteenUnscaledRuleNode (m : ℕ) : FourteenNodeIndex m → ℝ :=
  Sum.elim fourteenStripNode (Sum.elim (fun j => (j:ℝ)+24+1/2) (fun i => (m:ℝ)-fourteenStripNode i))

def fourteenRuleNode (m : ℕ) (i : FourteenNodeIndex m) : ℝ := fourteenUnscaledRuleNode m i / m

def fourteenQuadrature (m : ℕ) (f : ℝ → ℝ) : ℝ :=
  ((∑ i : Fin 24, f (fourteenStripNode i/m)) +
    (∑ j ∈ Finset.range (m-48), f (((j:ℝ)+24+1/2)/m)) +
    (∑ i : Fin 24, f (((m:ℝ)-fourteenStripNode i)/m))) / m

theorem fourteenNodeIndex_card {m : ℕ} (hm : 48 ≤ m) : Fintype.card (FourteenNodeIndex m) = m := by
  simp only [FourteenNodeIndex, Fintype.card_sum, Fintype.card_fin]
  omega

theorem fourteenQuadrature_as_node_sum (m : ℕ) (f : ℝ → ℝ) :
    fourteenQuadrature m f = (∑ i : FourteenNodeIndex m, f (fourteenRuleNode m i))/m := by
  simp [fourteenQuadrature,FourteenNodeIndex,fourteenRuleNode,fourteenUnscaledRuleNode,
    Fintype.sum_sum_type, ← Fin.sum_univ_eq_sum_range,add_assoc]

theorem fourteenQuadrature_add (m : ℕ) (f g : ℝ → ℝ) :
    fourteenQuadrature m (fun x => f x+g x) = fourteenQuadrature m f+fourteenQuadrature m g := by
  simp only [fourteenQuadrature,Finset.sum_add_distrib]
  ring

theorem fourteenQuadrature_mul_const (m : ℕ) (c : ℝ) (f : ℝ → ℝ) :
    fourteenQuadrature m (fun x => c*f x) = c*fourteenQuadrature m f := by
  simp only [fourteenQuadrature,← Finset.mul_sum]
  ring

theorem fourteenQuadrature_finset_sum {ι : Type*} (m : ℕ) (s : Finset ι) (f : ι → ℝ → ℝ) :
    fourteenQuadrature m (fun x => ∑ i ∈ s, f i x)=∑ i ∈ s,fourteenQuadrature m (f i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [fourteenQuadrature]
  | @insert i s hi ih =>
    simp only [Finset.sum_insert hi]
    rw [fourteenQuadrature_add,ih]

theorem fourteen_unscaled_power_sum {m : ℕ} (hm : 48 ≤ m) (k : Fin 14) :
    (∑ i : Fin 24,(fourteenStripNode i)^k.val) +
    (∑ j ∈ Finset.range (m-48),((j:ℝ)+24+1/2)^k.val) +
    (∑ i : Fin 24,((m:ℝ)-fourteenStripNode i)^k.val) = (m:ℝ)^(k.val+1)/(k.val+1) := by
  rw [fourteen_shifted_midpoint_sum]
  have hn : ((m-48:ℕ):ℝ)=(m:ℝ)-48 := by rw [Nat.cast_sub hm]; norm_num
  have hp := fourteenStrip_pair_sum k (m:ℝ)
  rw [Finset.sum_add_distrib] at hp
  rw [hn]
  have heq : (∑ i : Fin 24,(fourteenStripNode i)^k.val) +
      (fourteenMidpointPrimitive k ((m:ℝ)-48+24)-fourteenMidpointPrimitive k 24) +
      (∑ i : Fin 24,((m:ℝ)-fourteenStripNode i)^k.val) =
      fourteenPairFormula k m + (fourteenMidpointPrimitive k ((m:ℝ)-48+24)-fourteenMidpointPrimitive k 24) := by linarith
  rw [heq]
  fin_cases k <;> norm_num [fourteenMidpointPrimitive,fourteenPairFormula] <;> ring

theorem fourteenQuadrature_monomial {m : ℕ} (hm : 48 ≤ m) (k : Fin 14) :
    fourteenQuadrature m (fun x => x^k.val) = 1/(k.val+1:ℝ) := by
  have hm0 : (m:ℝ) ≠ 0 := by exact_mod_cast (by omega : m ≠ 0)
  unfold fourteenQuadrature
  simp only [div_pow, ← Finset.sum_div]
  rw [← add_div,← add_div,fourteen_unscaled_power_sum hm,pow_succ]
  field_simp

theorem fourteenQuadrature_monomial_integral {m : ℕ} (hm : 48 ≤ m) (k : Fin 14) :
    fourteenQuadrature m (fun x => x^k.val) = ∫ x in (0:ℝ)..1,x^k.val := by
  rw [fourteenQuadrature_monomial hm,integral_pow]
  simp

theorem fourteenQuadrature_degree_thirteen {m : ℕ} (hm : 48 ≤ m) (a : Fin 14 → ℝ) :
    fourteenQuadrature m (fun x => ∑ k : Fin 14,a k*x^k.val) =
      ∫ x in (0:ℝ)..1,∑ k : Fin 14,a k*x^k.val := by
  rw [fourteenQuadrature_finset_sum,intervalIntegral.integral_finsetSum]
  · simp_rw [fourteenQuadrature_mul_const,fourteenQuadrature_monomial_integral hm,
      intervalIntegral.integral_const_mul]
  · intro k _
    exact (by fun_prop : Continuous (fun x : ℝ => a k*x^k.val)).intervalIntegrable _ _

