theorem fourteenStripNode_strictMono : StrictMono fourteenStripNode := by
  intro i j hij
  have hi := (fourteenStripNode_bounds i).2
  have hj := (fourteenStripNode_bounds j).1
  have hle : (i:ℝ)+1 ≤ (j:ℝ) := by exact_mod_cast Nat.succ_le_of_lt hij
  linarith

theorem fourteenStripNode_between (i : Fin 24) : 0 < fourteenStripNode i ∧ fourteenStripNode i < 24 := by
  have h := fourteenStripNode_bounds i
  have hi : (i:ℝ) < 24 := by exact_mod_cast i.isLt
  have hi' : (i:ℝ) ≤ 23 := by exact_mod_cast (show i.val ≤ 23 by omega)
  have h0 : (0:ℝ) ≤ i := by positivity
  constructor <;> linarith

private theorem fourteen_middle_between {m : ℕ} (hm : 48 ≤ m) (j : Fin (m-48)) :
    24 < (j:ℝ)+24+1/2 ∧ (j:ℝ)+24+1/2 < (m:ℝ)-24 := by
  have hj : (j:ℕ)+49 ≤ m := by have := j.isLt; omega
  have hr : (j:ℝ)+49 ≤ (m:ℝ) := by exact_mod_cast hj
  have h0 : (0:ℝ) ≤ j := by positivity
  constructor <;> linarith

theorem fourteenUnscaledRuleNode_injective {m : ℕ} (hm : 48 ≤ m) :
    Function.Injective (fourteenUnscaledRuleNode m) := by
  rw [fourteenUnscaledRuleNode,Sum.elim_injective]
  refine ⟨fourteenStripNode_strictMono.injective,?_,?_⟩
  · rw [Sum.elim_injective]
    refine ⟨?_,?_,?_⟩
    · intro i j h
      apply Fin.ext
      have : (i:ℝ)=(j:ℝ) := by linarith
      exact_mod_cast this
    · intro i j h
      apply fourteenStripNode_strictMono.injective
      linarith
    · intro j i h
      have hj := (fourteen_middle_between hm j).2
      have hi := (fourteenStripNode_between i).2
      linarith
  · intro i x h
    have hi := (fourteenStripNode_between i).2
    rcases x with j | j
    · have hj := (fourteen_middle_between hm j).1
      change fourteenStripNode i = (j:ℝ)+24+1/2 at h
      linarith
    · have hj := (fourteenStripNode_between j).2
      have hr : (48:ℝ) ≤ m := by exact_mod_cast hm
      change fourteenStripNode i = (m:ℝ)-fourteenStripNode j at h
      linarith

theorem fourteenRuleNode_injective {m : ℕ} (hm : 48 ≤ m) : Function.Injective (fourteenRuleNode m) := by
  have hm0 : (m:ℝ) ≠ 0 := by exact_mod_cast (by omega : m ≠ 0)
  intro i j h
  exact fourteenUnscaledRuleNode_injective hm ((div_left_inj' hm0).mp h)

theorem fourteenRuleNode_mem_unit {m : ℕ} (hm : 48 ≤ m) (i : FourteenNodeIndex m) :
    fourteenRuleNode m i ∈ Set.Ioo (0:ℝ) 1 := by
  have hr : (48:ℝ) ≤ m := by exact_mod_cast hm
  have hm0 : (0:ℝ) < m := by linarith
  unfold fourteenRuleNode
  rw [Set.mem_Ioo,div_pos_iff_of_pos_right hm0,div_lt_one hm0]
  rcases i with i | (i | i)
  · have hi := fourteenStripNode_between i
    change 0 < fourteenStripNode i ∧ fourteenStripNode i < (m:ℝ)
    constructor <;> linarith
  · have hi := fourteen_middle_between hm i
    change 0 < (i:ℝ)+24+1/2 ∧ (i:ℝ)+24+1/2 < (m:ℝ)
    constructor <;> linarith
  · have hi := fourteenStripNode_between i
    change 0 < (m:ℝ)-fourteenStripNode i ∧ (m:ℝ)-fourteenStripNode i < (m:ℝ)
    constructor <;> linarith

end SphericalRiesz.Boundary
