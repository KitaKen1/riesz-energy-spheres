/-- The nome of `10i/11` is below `1/3`. -/
theorem nome_lt : Real.exp (-π * (11 / 10 : ℝ)⁻¹) < 1 / 3 := by
  have hπ : (3 : ℝ) < π := Real.pi_gt_three
  have h1 : -π * (11 / 10 : ℝ)⁻¹ ≤ -2 := by
    rw [show ((11 / 10 : ℝ))⁻¹ = 10 / 11 by norm_num]
    linarith
  have h2 : (5 : ℝ) ≤ Real.exp 2 := by
    have h := Real.quadratic_le_exp_of_nonneg (x := 2) (by norm_num)
    norm_num at h
    linarith
  have h3 : Real.exp (-2) < 1 / 3 := by
    rw [Real.exp_neg, inv_eq_one_div]
    exact one_div_lt_one_div_of_lt (by norm_num) (by linarith)
  exact lt_of_le_of_lt (Real.exp_le_exp.mpr h1) h3

