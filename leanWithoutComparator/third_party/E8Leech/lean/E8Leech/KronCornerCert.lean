theorem ckmrvEightHatKernel_pos_corner {u t : ℝ} (hu : (10 / 11 : ℝ) ≤ u)
    (hu' : u ≤ 11 / 10) (ht : (10 / 11 : ℝ) ≤ t) (ht' : t ≤ 11 / 10)
    (hJ : kleinModularJ (imagPt u) ≠ kleinModularJ (imagPt t)) :
    0 < (ckmrvEightHatKernel (imagPt u) (imagPt t)).re := by
  have hinv : ((11 / 10 : ℝ))⁻¹ = 10 / 11 := by norm_num
  refine Kron.kernel_pos_of_corner (Λ := Kron.Corner.Λ) (by decide) Kron.Corner.tau_only
    Kron.Corner.z_only (c₀ := 11 / 10) (by norm_num) Kron.Corner.nome_lt
    Kron.Corner.corner_pos ?_ hu' ?_ ht' hJ
  · rw [hinv]
    exact hu
  · rw [hinv]
