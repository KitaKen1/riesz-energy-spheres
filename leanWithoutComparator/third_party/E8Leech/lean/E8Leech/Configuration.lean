import Mathlib.Data.Set.Card
import Mathlib.MeasureTheory.Measure.Count
import Mathlib.MeasureTheory.Constructions.BorelSpace.Real
import Mathlib.MeasureTheory.MeasurableSpace.Constructions
import Mathlib.Topology.Homeomorph.Lemmas
import Mathlib.Topology.MetricSpace.ProperSpace

/-!
# Simple locally finite configurations

A configuration has an unlabelled support, finite on every compact window. Its measurable
structure is generated by counts in Borel sets. Counts and energies use extended nonnegative
values, so infinite counts are never replaced by a natural-number default.
-/

noncomputable section

namespace E8Leech

open Set MeasureTheory
open scoped ENNReal

variable {X : Type*} [TopologicalSpace X]

/-- An unlabelled simple configuration, finite on compact windows. -/
structure Configuration (X : Type*) [TopologicalSpace X] where
  support : Set X
  finite_on_compacts : ∀ K : Set X, IsCompact K → (support ∩ K).Finite

namespace Configuration

instance : Coe (Configuration X) (Set X) := ⟨Configuration.support⟩

@[ext] theorem ext {c d : Configuration X} (h : c.support = d.support) : c = d := by
  cases c
  cases d
  simp_all

/-- Restrict a configuration by an arbitrary deterministic predicate. -/
def restrict (c : Configuration X) (A : Set X) : Configuration X where
  support := c.support ∩ A
  finite_on_compacts K hK := (c.finite_on_compacts K hK).subset (by
    intro x hx
    exact ⟨hx.1.1, hx.2⟩)

/-- Transport the support by a homeomorphism. -/
def mapHomeomorph (e : X ≃ₜ X) (c : Configuration X) : Configuration X where
  support := e '' c.support
  finite_on_compacts K hK := by
    have hpre : IsCompact (e ⁻¹' K) := by
      have heq : e ⁻¹' K = e.symm '' K := by
        ext x
        constructor
        · intro hx
          exact ⟨e x, hx, e.symm_apply_apply x⟩
        · rintro ⟨y, hy, rfl⟩
          simpa using hy
      rw [heq]
      exact hK.image e.symm.continuous
    have hfinite := (c.finite_on_compacts (e ⁻¹' K) hpre).image e
    have heq : e '' (c.support ∩ e ⁻¹' K) = e '' c.support ∩ K := by
      exact Set.image_inter_preimage e c.support K
    rwa [heq] at hfinite

section Counting

variable [MeasurableSpace X] [MeasurableSingletonClass X]

/-- Number of points in a window, including `∞` for infinite windows. -/
def count (c : Configuration X) (A : Set X) : ℝ≥0∞ :=
  Measure.count (c.support ∩ A)

theorem count_eq_encard (c : Configuration X) (A : Set X) :
    c.count A = ((c.support ∩ A).encard : ℝ≥0∞) := by
  by_cases h : (c.support ∩ A).Finite
  · rw [count, Measure.count_apply_finite _ h, h.encard_eq_coe_toFinset_card]
    simp
  · rw [count, Measure.count_apply_infinite h, Set.Infinite.encard_eq h]
    simp

omit [MeasurableSingletonClass X] in
theorem count_eq_zero_iff (c : Configuration X) (A : Set X) :
    c.count A = 0 ↔ c.support ∩ A = ∅ := Measure.count_eq_zero_iff

theorem one_le_count_of_mem (c : Configuration X) (A : Set X) {x : X}
    (hx : x ∈ c.support ∩ A) : 1 ≤ c.count A := by
  have hmono : (Measure.count : Measure X) {x} ≤ Measure.count (c.support ∩ A) :=
    measure_mono (show ({x} : Set X) ⊆ c.support ∩ A by simpa)
  simpa [count] using (hmono : Measure.count ({x} : Set X) ≤ Measure.count (c.support ∩ A))

theorem count_ne_top_of_compact (c : Configuration X) {K : Set X} (hK : IsCompact K) :
    c.count K ≠ ∞ := by
  exact (Measure.count_apply_lt_top (s := c.support ∩ K)).mpr
    (c.finite_on_compacts K hK) |>.ne

theorem count_mapHomeomorph (e : X ≃ₜ X) (c : Configuration X) (A : Set X) :
    (c.mapHomeomorph e).count A = c.count (e ⁻¹' A) := by
  change Measure.count (e '' c.support ∩ A) = Measure.count (c.support ∩ e ⁻¹' A)
  rw [← Set.image_inter_preimage e c.support A]
  exact Measure.count_injective_image e.injective _

end Counting

section Measurable

variable [MeasurableSpace X] [MeasurableSingletonClass X]

/-- The counting sigma algebra: generated by all Borel-window counting maps. -/
instance : MeasurableSpace (Configuration X) :=
  ⨆ A : {A : Set X // MeasurableSet A},
    MeasurableSpace.comap (fun c : Configuration X => c.count A.1) inferInstance

omit [MeasurableSingletonClass X] in
theorem measurable_count {A : Set X} (hA : MeasurableSet A) :
    Measurable (fun c : Configuration X => c.count A) := by
  apply Measurable.of_comap_le
  exact le_iSup_of_le (⟨A, hA⟩ : {A : Set X // MeasurableSet A}) le_rfl

omit [MeasurableSingletonClass X] in
theorem measurable_of_counts {A : Type*} [MeasurableSpace A]
    {f : A → Configuration X}
    (hf : ∀ W : Set X, MeasurableSet W → Measurable (fun a => (f a).count W)) :
    Measurable f := by
  rw [measurable_iff_comap_le]
  change MeasurableSpace.comap f
    (⨆ W : {W : Set X // MeasurableSet W},
      MeasurableSpace.comap (fun c : Configuration X => c.count W.1) inferInstance) ≤ _
  rw [MeasurableSpace.comap_iSup]
  refine iSup_le fun W => ?_
  rw [MeasurableSpace.comap_comp]
  simpa only [Function.comp_def] using (hf W W.2).comap_le

theorem measurable_mapHomeomorph [BorelSpace X] (e : X ≃ₜ X) :
    Measurable (mapHomeomorph e : Configuration X → Configuration X) := by
  rw [measurable_iff_comap_le]
  change MeasurableSpace.comap (mapHomeomorph e)
    (⨆ A : {A : Set X // MeasurableSet A},
      MeasurableSpace.comap (fun c : Configuration X => c.count A.1) inferInstance) ≤ _
  rw [MeasurableSpace.comap_iSup]
  refine iSup_le fun A => ?_
  rw [MeasurableSpace.comap_comp]
  have h := measurable_count (A.2.preimage e.continuous.measurable)
  simpa only [Function.comp_def, count_mapHomeomorph] using h.comap_le

end Measurable

/-- Local finiteness gives countability by covering the space with compact closed balls. -/
theorem countable_support {Y : Type*} [PseudoMetricSpace Y] [ProperSpace Y]
    (c : Configuration Y) (o : Y) : c.support.Countable := by
  have hcover : c.support = ⋃ n : ℕ, c.support ∩ Metric.closedBall o (n : ℝ) := by
    ext x
    simp only [Set.mem_iUnion, Set.mem_inter_iff, Metric.mem_closedBall]
    constructor
    · intro hx
      obtain ⟨n, hn⟩ := exists_nat_gt (dist x o)
      exact ⟨n, hx, hn.le⟩
    · rintro ⟨n, hx, _⟩
      exact hx
  rw [hcover]
  exact Set.countable_iUnion fun n =>
    (c.finite_on_compacts _ (isCompact_closedBall o (n : ℝ))).countable

end Configuration
end E8Leech
